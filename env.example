# ── OpenRouter (usado por CASPER-3 e ADAM-0) ─────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODELO=deepseek/deepseek-chat-v3-0324:free

# ── Google Gemini (usado por MELCHIOR-1 e BALTHASAR-2) ───────
GOOGLE_API_KEY=

# ── DeepSeek (opcional — fallback) ───────────────────────────
DEEPSEEK_API_KEY=

# ── OpenAI (opcional — fallback de evolução) ──────────────────
OPENAI_API_KEY=


# ── Modelo local via LM Studio / Ollama (opcional) ───────────
LOCAL_ATIVO=true
LOCAL_URL=http://127.0.0.1:1234/v1
LOCAL_MODELO=qwen3-14b
